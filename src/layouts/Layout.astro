---
import '../styles/global.css'

interface Props {
  title: string;
  showNav?: boolean;
  showLandscape?: boolean;
  showTub?: boolean;
  scrollable?: boolean;
}

const { title, showNav = false, showLandscape = false, showTub = true, scrollable = false } = Astro.props;
---

<!doctype html>
<html lang="en" class={(showNav || scrollable) ? 'scrollable' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Daniel Lopez-Cope - Personal & Professional Portfolio" />
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400;500&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <!-- Landscape Background for inner pages -->
    {showLandscape && (
      <>
        <div class="landscape-bg revealed"></div>
        <div class="landscape-overlay show"></div>
      </>
    )}

    <!-- Navigation (shown after reveal) -->
    {showNav && (
      <nav class="fixed top-0 left-0 right-0 z-50 bg-black/60 backdrop-blur-md border-b border-white/10">
        <div class="max-w-6xl mx-auto px-4 md:px-6 py-4 flex items-center justify-between">
          <a href="/" class="text-xl font-light tracking-wider text-white">DLC</a>

          <!-- Desktop nav -->
          <div class="hidden md:flex gap-2">
            <a href="/" class="nav-link">Home</a>
            <a href="/personal" class="nav-link">Personal</a>
            <a href="/professional" class="nav-link">Professional</a>
            <a href="/socials" class="nav-link">Socials</a>
            <a href="/stories" class="nav-link">Dark Tales</a>
            <a href="/news" class="nav-link">News</a>
          </div>

          <!-- Mobile hamburger -->
          <button id="nav-mobile-menu-btn" class="md:hidden text-white text-2xl p-2" aria-label="Open menu">
            ☰
          </button>
        </div>
      </nav>
    )}

    <!-- Mobile nav overlay (for inner pages) -->
    {showNav && (
      <div id="nav-mobile-menu" class="nav-mobile-overlay">
        <div class="nav-mobile-content">
          <button id="nav-mobile-close" class="nav-mobile-close" aria-label="Close menu">✕</button>
          <nav class="nav-mobile-links">
            <a href="/" class="nav-mobile-link">Home</a>
            <a href="/personal" class="nav-mobile-link">Personal</a>
            <a href="/professional" class="nav-mobile-link">Professional</a>
            <a href="/socials" class="nav-mobile-link">Socials</a>
            <a href="/stories" class="nav-mobile-link">Dark Tales</a>
            <a href="/news" class="nav-mobile-link">News</a>
          </nav>
        </div>
      </div>
    )}

    <!-- Main Content -->
    <main class={showNav ? "pt-20 relative z-10" : "relative z-10"}>
      <slot />
    </main>

    <!-- Dachshund Easter Egg - Tub -->
    {showTub && (
      <>
        <div class="dachshund-container" id="dachshund">
          <img src="/images/tub-right.svg" alt="Tub the dachshund" class="tub-image tub-right" />
          <img src="/images/tub.svg" alt="Tub the dachshund" class="tub-image tub-left" />
        </div>

        <!-- Bone for Easter egg -->
        <svg class="bone" id="bone" viewBox="0 0 100 40">
          <ellipse cx="15" cy="10" rx="10" ry="7" fill="#f5f5dc" stroke="#B5835A" stroke-width="1"/>
          <ellipse cx="15" cy="30" rx="10" ry="7" fill="#f5f5dc" stroke="#B5835A" stroke-width="1"/>
          <ellipse cx="85" cy="10" rx="10" ry="7" fill="#f5f5dc" stroke="#B5835A" stroke-width="1"/>
          <ellipse cx="85" cy="30" rx="10" ry="7" fill="#f5f5dc" stroke="#B5835A" stroke-width="1"/>
          <rect x="15" y="13" width="70" height="14" rx="7" fill="#f5f5dc" stroke="#B5835A" stroke-width="1"/>
        </svg>
      </>
    )}

    <script>
      import { defineTweaks, tweak, onTweakChange, mountTweakPanel } from '../scripts/tweaks';

      // Knobs this page owns. Defaults mirror the committed constants, so a
      // fresh visitor sees exactly what the source says.
      defineTweaks([
        { group: 'bone', key: 'bone.gravity', label: 'gravity',     min: 0.1, max: 3,   step: 0.05, value: 0.9 },
        { group: 'bone', key: 'bone.bounce',  label: 'bounce',      min: 0,   max: 0.9, step: 0.05, value: 0.35 },
        { group: 'bone', key: 'bone.ground',  label: 'ground line', min: 0,   max: 200, step: 2,    value: 24 },
        { group: 'tub',  key: 'tub.speed',    label: 'top speed',   min: 1,   max: 20,  step: 0.5,  value: 6 },
      ]);

      mountTweakPanel();

      // Nav mobile menu toggle
      document.addEventListener('DOMContentLoaded', () => {
        const navMenuBtn = document.getElementById('nav-mobile-menu-btn');
        const navMenuClose = document.getElementById('nav-mobile-close');
        const navMenu = document.getElementById('nav-mobile-menu');
        const navLinks = document.querySelectorAll('.nav-mobile-link');

        function openNavMenu() {
          navMenu?.classList.add('open');
          document.body.style.overflow = 'hidden';
        }

        function closeNavMenu() {
          navMenu?.classList.remove('open');
          document.body.style.overflow = '';
        }

        navMenuBtn?.addEventListener('click', openNavMenu);
        navMenuClose?.addEventListener('click', closeNavMenu);

        navLinks.forEach(link => {
          link.addEventListener('click', closeNavMenu);
        });

        navMenu?.addEventListener('click', (e) => {
          if (e.target === navMenu) closeNavMenu();
        });
      });

      // Dachshund (Tub) Easter egg - drag the bone anywhere, drop it, Tub trots over
      document.addEventListener('DOMContentLoaded', () => {
        const dachshund = document.getElementById('dachshund') as HTMLElement | null;
        const bone = document.getElementById('bone') as HTMLElement | null;

        if (dachshund && bone) {
          const BONE_W = 80;
          const BONE_H = 35;
          /* Read through the store rather than captured once, so a slider in
             the tweak panel takes effect on the very next frame. */
          const GROUND = () => tweak('bone.ground');
          const GRAVITY = () => tweak('bone.gravity');
          const BOUNCE = () => tweak('bone.bounce');
          const TOP_SPEED = () => tweak('tub.speed');
          const TUB_W = 640;
          const NOSE_RIGHT = 375;    // container left offset that puts his nose on the bone
          const NOSE_LEFT = 150;
          const FLIP_THRESHOLD = 60; // hysteresis so he doesn't flip-flop in place
          const ARRIVE = 12;

          let boneX = -200;
          let boneY = GROUND();
          let boneVX = 0;
          let boneVY = 0;
          let falling = false;
          let dragging = false;
          let grabDX = 0;
          let grabDY = 0;
          let lastPointerX = 0;
          let dragDistance = 0;

          let tubX = -650;
          let tubY = GROUND() - 150;
          let facingRight = true;
          let walking = false;
          let atBone = false;
          let ticking = false;

          function clamp(v: number, min: number, max: number) {
            return Math.min(Math.max(v, min), max);
          }

          function maxBoneX() {
            return Math.max(0, window.innerWidth - BONE_W);
          }

          function setDirection(right: boolean) {
            facingRight = right;
            dachshund.classList.toggle('facing-right', right);
            dachshund.classList.toggle('facing-left', !right);
          }

          // The bone should never come to rest on top of something clickable
          function overlapsInteractive(x: number, y: number) {
            const left = x;
            const top = window.innerHeight - y - BONE_H;
            const pad = 8;
            const interactives = document.querySelectorAll('a, button, [role="button"], input, select, textarea');
            for (const el of interactives) {
              if ((el as HTMLElement).closest('.dachshund-container') || el === bone) continue;
              const rect = el.getBoundingClientRect();
              if (rect.width === 0 || rect.height === 0) continue;
              if (
                left < rect.right + pad &&
                left + BONE_W > rect.left - pad &&
                top < rect.bottom + pad &&
                top + BONE_H > rect.top - pad
              ) {
                return true;
              }
            }
            return false;
          }

          // Roll the bone sideways to the nearest clear spot after it lands
          function rollClear() {
            if (!overlapsInteractive(boneX, boneY)) return;
            const limit = maxBoneX();
            for (let step = 20; step <= 500; step += 20) {
              for (const candidate of [boneX + step, boneX - step]) {
                const x = clamp(candidate, 0, limit);
                if (!overlapsInteractive(x, boneY)) {
                  boneX = x;
                  return;
                }
              }
            }
          }

          function render() {
            tubY = GROUND() - 150;
            bone.style.left = `${boneX}px`;
            bone.style.bottom = `${boneY}px`;
            dachshund.style.left = `${tubX}px`;
            dachshund.style.bottom = `${tubY}px`;
          }

          function tick() {
            // Bone physics - only while it's in the air and not being held
            if (!dragging && falling) {
              boneVY -= GRAVITY();
              boneY += boneVY;
              boneX = clamp(boneX + boneVX, 0, maxBoneX());
              boneVX *= 0.94;

              if (boneY <= GROUND()) {
                boneY = GROUND();
                if (Math.abs(boneVY) > 4) {
                  boneVY = Math.abs(boneVY) * BOUNCE();
                } else {
                  boneVY = 0;
                  boneVX = 0;
                  falling = false;
                  rollClear();
                  bone.classList.remove('landing');
                  void bone.getBoundingClientRect();
                  bone.classList.add('landing');
                }
              }
            }

            // Tub tracks the bone horizontally along the ground
            const diff = (boneX + BONE_W / 2) - (tubX + TUB_W / 2);
            if (Math.abs(diff) > FLIP_THRESHOLD) setDirection(diff > 0);

            const targetX = boneX - (facingRight ? NOSE_RIGHT : NOSE_LEFT);
            const dx = targetX - tubX;

            if (Math.abs(dx) > ARRIVE) {
              const speed = Math.min(TOP_SPEED(), Math.abs(dx) * 0.04 + 1.5);
              tubX += Math.sign(dx) * speed;
              atBone = false;
              if (!walking) {
                walking = true;
                dachshund.classList.add('walking');
              }
            } else {
              tubX = targetX;
              atBone = true;
              if (walking) {
                walking = false;
                dachshund.classList.remove('walking');
              }
            }

            // Beg when the bone is dangled overhead
            dachshund.classList.toggle('begging', dragging && atBone && boneY > GROUND() + 60);

            render();

            // Nothing left to animate - park the loop until the bone moves again
            if (!dragging && !falling && atBone) {
              ticking = false;
              return;
            }
            requestAnimationFrame(tick);
          }

          function kick() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(tick);
          }

          /* The loop parks itself once everything is at rest, so a slider
             moved while the bone is idle would appear to do nothing. Wake it
             and let the bone re-settle against the new numbers. */
          onTweakChange(() => {
            atBone = false;
            falling = true;
            kick();
          });

          // --- Drag and drop -----------------------------------------------
          bone.addEventListener('pointerdown', (e) => {
            const evt = e as PointerEvent;
            evt.preventDefault();
            evt.stopPropagation();

            dragging = true;
            falling = false;
            boneVX = 0;
            boneVY = 0;
            dragDistance = 0;
            lastPointerX = evt.clientX;

            const rect = bone.getBoundingClientRect();
            grabDX = evt.clientX - rect.left;
            grabDY = evt.clientY - rect.top;

            bone.classList.remove('landing');
            bone.classList.add('dragging');
            kick();
            try { bone.setPointerCapture(evt.pointerId); } catch (err) { /* no capture support */ }
          });

          bone.addEventListener('pointermove', (e) => {
            if (!dragging) return;
            const evt = e as PointerEvent;
            const nextX = clamp(evt.clientX - grabDX, 0, maxBoneX());
            const nextY = clamp(
              window.innerHeight - (evt.clientY - grabDY) - BONE_H,
              GROUND(),
              Math.max(GROUND(), window.innerHeight - BONE_H - 10)
            );

            dragDistance += Math.abs(nextX - boneX) + Math.abs(nextY - boneY);
            boneVX = (evt.clientX - lastPointerX) * 0.5;
            lastPointerX = evt.clientX;
            boneX = nextX;
            boneY = nextY;
            kick();
          });

          function endDrag() {
            if (!dragging) return;
            dragging = false;
            bone.classList.remove('dragging');
            dachshund.classList.remove('begging');

            // A plain tap still does something: toss the bone a short hop
            if (dragDistance < 6) {
              boneVY = 10;
              boneVX = (Math.random() - 0.5) * 8;
            }
            falling = true;
            kick();
          }

          bone.addEventListener('pointerup', endDrag);
          bone.addEventListener('pointercancel', endDrag);
          bone.addEventListener('lostpointercapture', endDrag);

          window.addEventListener('resize', () => {
            boneX = clamp(boneX, 0, maxBoneX());
            atBone = false;
            kick();
          });

          function startSequence() {
            boneX = clamp(window.innerWidth - 160, 0, maxBoneX());
            boneY = Math.min(window.innerHeight * 0.55, 420);
            boneVX = 0;
            boneVY = 0;
            falling = true;

            tubX = -650;
            setDirection(true);
            render();
            bone.classList.add('show');
            kick();

            setTimeout(() => {
              dachshund.classList.add('visible');
            }, 500);
          }

          // Check if we should start
          function checkAndStart() {
            const welcomeScreen = document.getElementById('welcome-screen');
            const introSeen = sessionStorage.getItem('introSeen');

            if (!welcomeScreen || introSeen === 'true') {
              setTimeout(startSequence, 4000);
              return true;
            }
            return false;
          }

          // Try to start, or watch for intro completion
          if (!checkAndStart()) {
            const checkInterval = setInterval(() => {
              if (sessionStorage.getItem('introSeen') === 'true') {
                clearInterval(checkInterval);
                setTimeout(startSequence, 2000);
              }
            }, 500);
          }
        }
      });
    </script>
  </body>
</html>
